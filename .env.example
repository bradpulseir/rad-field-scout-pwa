# ==============================================================================
# RAD FIELD SCOUT NETWORK - ENVIRONMENT VARIABLES
# ==============================================================================
# 
# INSTRUCTIONS FOR CLIENT DEPLOYMENT:
# 1. Copy this file and rename it to `.env.local` for local development, 
#    or add these variables to your Vercel project settings for production.
# 2. DO NOT commit `.env.local` to version control.
#
# ==============================================================================

# ------------------------------------------------------------------------------
# SUPABASE CONFIGURATION
# ------------------------------------------------------------------------------
# Obtain these from your Supabase Project Dashboard -> Project Settings -> API
# 
# NEXT_PUBLIC_SUPABASE_URL: The unique URL of your Supabase project REST API.
# NEXT_PUBLIC_SUPABASE_ANON_KEY: The public anon key for browser-side requests.
#
NEXT_PUBLIC_SUPABASE_URL="https://your-project-id.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="your-supabase-anon-key-here"

# ------------------------------------------------------------------------------
# (OPTIONAL) THIRD-PARTY APIs
# ------------------------------------------------------------------------------
# If you decide to add reverse-geocoding (converting GPS to text address) in the 
# future, you can add those keys here. The current MVP uses standard HTML5 Geolocation.
#
# GOOGLE_PLACES_API_KEY="your-google-places-api-key"
