# ==============================================================================
# AITX ($AITX) | RAD FIELD SCOUT NETWORK - ENVIRONMENT VARIABLES
# ==============================================================================
# 
# INSTRUCTIONS FOR CLIENT DEPLOYMENT:
# 1. Copy this file and rename it to `.env.local` for local development, 
#    or add these variables to your Vercel project settings for production.
# 2. DO NOT commit `.env.local` to version control.
#
# ==============================================================================

# ------------------------------------------------------------------------------
# SUPABASE CONFIGURATION
# ------------------------------------------------------------------------------
# Obtain these from your Supabase Project Dashboard -> Project Settings -> API
# 
NEXT_PUBLIC_SUPABASE_URL="https://your-project-id.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="your-supabase-anon-key-here"

# ------------------------------------------------------------------------------
# APP CANONICAL URL
# ------------------------------------------------------------------------------
NEXT_PUBLIC_APP_URL="https://rad-field-scout.vercel.app"

# ------------------------------------------------------------------------------
# NATIVE MAILCHIMP v3 API INTEGRATION (CHIMP TAGS)
# ------------------------------------------------------------------------------
# Automatically upserts subscribers into your existing Mailchimp Audience and
# applies tags ("AITX_Field_Scout_Program", "Field_Scout", "Field_Scout_Referral").
#
MAILCHIMP_API_KEY=""
MAILCHIMP_AUDIENCE_ID=""

# (Optional) Webhook fallback if using Zapier / Make instead of direct Mailchimp API
MAILCHIMP_ZAPIER_WEBHOOK_URL=""

# ------------------------------------------------------------------------------
# CUSTOM SMTP / DEDICATED GMAIL SETTINGS
# ------------------------------------------------------------------------------
# Configure inside Supabase Dashboard -> Authentication -> SMTP Settings
# (e.g. smtp.gmail.com with a 16-character Google App Password).
#
SMTP_FROM_EMAIL="radfieldscout@gmail.com"
