# ==============================================================================
# AITX ($AITX) | RAD FIELD SCOUT NETWORK - ENVIRONMENT VARIABLES
# ==============================================================================
# 
# INSTRUCTIONS FOR CLIENT DEPLOYMENT:
# 1. Copy this file and rename it to `.env.local` for local development, 
#    or add these variables to your Vercel project settings for production.
# 2. DO NOT commit `.env.local` to version control.
#
# ==============================================================================

# ------------------------------------------------------------------------------
# SUPABASE CONFIGURATION
# ------------------------------------------------------------------------------
# Obtain these from your Supabase Project Dashboard -> Project Settings -> API
# 
# NEXT_PUBLIC_SUPABASE_URL: The unique URL of your Supabase project REST API.
# NEXT_PUBLIC_SUPABASE_ANON_KEY: The public anon key for browser-side requests.
#
NEXT_PUBLIC_SUPABASE_URL="https://your-project-id.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="your-supabase-anon-key-here"

# ------------------------------------------------------------------------------
# APP CANONICAL URL
# ------------------------------------------------------------------------------
NEXT_PUBLIC_APP_URL="https://rad-field-scout.vercel.app"

# ------------------------------------------------------------------------------
# CRM & MARKETING AUTOMATION (MAILCHIMP / ZAPIER / HUBSPOT)
# ------------------------------------------------------------------------------
# Optional webhook endpoint for auto-syncing new scouts, referrals, and submitted leads.
# If omitted or empty, the app will gracefully queue and log sync events locally without errors.
#
MAILCHIMP_ZAPIER_WEBHOOK_URL=""

# ------------------------------------------------------------------------------
# CUSTOM SMTP SETTINGS (OPTIONAL - UNLOCKS BRANDED EMAIL TEMPLATES)
# ------------------------------------------------------------------------------
# Configure inside Supabase Dashboard -> Authentication -> SMTP Settings,
# or provide here if using custom transactional email services (e.g. Resend, SendGrid).
#
SMTP_FROM_EMAIL="scouts@aitx.ai"

# ------------------------------------------------------------------------------
# (OPTIONAL) THIRD-PARTY MAPS & GEOCODING
# ------------------------------------------------------------------------------
# Current app uses browser HTML5 Geolocation API (zero-config).
#
# GOOGLE_PLACES_API_KEY="your-google-places-api-key"
